// ────────────────[ Miscellaneous ]──────────────── \\
spawn-sh-at-startup "sleep 3 && pw-play $HOME/.local/share/sounds/Windows_95.ogg"

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

blur {
    passes 4
    offset 2
    noise 0
    saturation 1.2
}

workspace "1"
workspace "2"
workspace "3"

// ────────────────[ Layout ]──────────────── \\
layout {
    gaps 8
    background-color "transparent"

    preset-column-widths {
        proportion 0.5
        proportion 0.67
        proportion 1.0
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        off
    }

    border {
        on
        width 2.5
    }

    shadow {
        on
        softness 10
        spread 2
        offset x=0 y=5
    }
}

// ────────────────[ Window Rules ]──────────────── \\
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
    draw-border-with-background false
    background-effect {
        xray false
        blur true
    }
    popups {
        geometry-corner-radius 15
        opacity 0.9
        background-effect {
            xray false
            blur true
        }
    }
}

window-rule {
    opacity 0.9
    exclude app-id="discord|helium|imv|mpv|org.gnome.Boxes|steam"
}

window-rule {
    match app-id="imv"
    open-floating true
    default-column-width { fixed 1000; }
    default-window-height { fixed 600; }
}

window-rule {
    match app-id="discord|helium"
    open-on-workspace "1"
}

window-rule {
    match app-id="dev.zed.Zed|org.kde.kid3|org.qbittorrent.qBittorrent"
    open-maximized true
    open-on-workspace "2"
}

window-rule {
    match app-id="steam|io.github.elyprismlauncher.ElyPrismLauncher" title="^Steam$|^PineconeMC"
    open-maximized true
    open-on-workspace "3"
}

window-rule {
    match app-id="steam|io.github.elyprismlauncher.ElyPrismLauncher"
    exclude title="^Steam$|^PineconeMC"
    open-floating true
    open-on-workspace "3"
}

window-rule {
    match app-id="org.chipass.ChiPass"
    block-out-from "screen-capture"
}

// ────────────────[ Layer Rules ]──────────────── \\
layer-rule {
    match namespace="quickshell"
    place-within-backdrop true
}

// ────────────────[ Gestures ]──────────────── \\
gestures {
    hot-corners {
        off
    }
}

// ────────────────[ Recent Windows ]──────────────── \\
recent-windows {
    debounce-ms 750
    open-delay-ms 0

    highlight {
        padding 10
        corner-radius 0
    }

    previews {
        max-height 200
        max-scale 0.5
    }
}

// DMS Include Configs
include "dms/outputs.kdl"
include "dms/binds.kdl"
include "dms/cursor.kdl"
include "dms/input.kdl"
include "dms/colors.kdl"
